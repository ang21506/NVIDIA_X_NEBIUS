# ==========================================
# LearnLoop AI — Environment Configuration
# ==========================================

# Application Environment
DEBUG=false
APP_NAME="LearnLoop AI"
APP_VERSION="1.0.0"

# Database Configuration
# Default: Local SQLite database for seamless zero-docker local dev
DATABASE_URL="sqlite:///./backend/data/learnloop.db"
# Production PostgreSQL with pgvector:
# DATABASE_URL="postgresql://learnloop_user:securepassword@localhost:5432/learnloop_db"

# Nebius Token Factory & NVIDIA Nemotron Credentials
# Required for live inference at runtime. Get your API key from https://tokenfactory.nebius.com
NEBIUS_API_KEY=""
NEBIUS_BASE_URL="https://api.tokenfactory.nebius.com/v1/"
NEBIUS_MODEL_ID="nvidia/Llama-3.1-Nemotron-70B-Instruct-HF"

# Authentication & Security
# Generate a secure random string for JWT token generation: openssl rand -hex 32
JWT_SECRET="learnloop-production-random-secret-key-change-me"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# File Storage & Document Processing
UPLOAD_DIR="./backend/data/uploads"
MAX_UPLOAD_SIZE_MB=25
CHUNK_SIZE=450
CHUNK_OVERLAP=75
EMBEDDING_DIMENSION=384

# Agent Orchestrator Limits
AGENT_MAX_TOOL_CALLS=8
AGENT_TIMEOUT_SECONDS=30

# Priority Heuristic Formula Coefficients
# Priority = 0.35*(1-mastery) + 0.25*exam_urgency + 0.20*forgetting_risk + 0.20*prereq_impact
WEIGHT_MASTERY_DEFICIT=0.35
WEIGHT_EXAM_URGENCY=0.25
WEIGHT_FORGETTING_RISK=0.20
WEIGHT_PREREQUISITE_IMPACT=0.20
